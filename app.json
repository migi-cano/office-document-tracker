{
  "expo": {
    "name": "ONENCR Document Tracker",
   "slug": "office-document-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/onencr.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.migimigs.officedocumenttracker",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
  "adaptiveIcon": {
    "foregroundImage": "./assets/images/onencr.png",
    "backgroundColor": "#FFFFFF"
  },
  "package": "com.migimigs.officedocumenttracker",
  "predictiveBackGestureEnabled": false
},
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "4563d7c6-c483-481f-ae37-aa1b5f4e26ba"
      }
    }
  }
}
